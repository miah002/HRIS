// HRIS Prisma schema. SQLite for portfolio demo; swap provider to "postgresql" for prod.
// Models reflect Philippine compliance needs: SSS/PhilHealth/Pag-IBIG/BIR numbers on employee,
// statutory leave types as an enum, and an Attendance model that supports DOLE OT/ND computation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Auth ---
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("OWNER") // OWNER | HR | EMPLOYEE
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id])
  employeeId    String?   @unique
  employee      Employee? @relation(fields: [employeeId], references: [id])
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// --- Core HR ---
model Company {
  id        String     @id @default(cuid())
  name      String
  tin       String?
  address   String?
  users     User[]
  employees Employee[]
  createdAt DateTime   @default(now())
}

model Employee {
  id               String       @id @default(cuid())
  companyId        String
  company          Company      @relation(fields: [companyId], references: [id])
  employeeNumber   String       @unique
  firstName        String
  middleName       String?
  lastName         String
  email            String?
  mobile           String?
  birthDate        DateTime?
  dateHired        DateTime
  position         String
  department       String
  employmentStatus String       // REGULAR | PROBATIONARY | PROJECT | CASUAL | CONTRACTUAL
  basicMonthlyRate Float        // PHP
  // Government IDs (PH-mandated)
  tin              String?
  sssNumber        String?
  philHealthNumber String?
  pagIbigNumber    String?
  // Status
  archived         Boolean      @default(false)
  archivedAt       DateTime?
  notes            String?
  attendance       Attendance[]
  payrolls         Payroll[]
  leaves           LeaveRequest[]
  documents        Document[]
  user             User?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Document {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String   // e.g. "Contract", "2316", "Government ID"
  url        String   // storage URL (mocked for demo)
  expiresAt  DateTime?
  uploadedAt DateTime @default(now())
}

model Attendance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  timeIn      DateTime?
  timeOut     DateTime?
  hoursWorked Float     @default(0)
  otHours     Float     @default(0) // regular OT in excess of 8h
  ndHours     Float     @default(0) // night differential hours (22:00–06:00)
  isRestDay   Boolean   @default(false)
  isHoliday   Boolean   @default(false)
  notes       String?
  @@unique([employeeId, date])
}

model Payroll {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart     DateTime
  periodEnd       DateTime
  // Earnings
  basicPay        Float
  overtimePay     Float    @default(0)
  nightDiffPay    Float    @default(0)
  holidayPay      Float    @default(0)
  allowances      Float    @default(0)
  grossPay        Float
  // Statutory deductions (PH)
  sssEE           Float    @default(0)
  philHealthEE    Float    @default(0)
  pagIbigEE       Float    @default(0)
  withholdingTax  Float    @default(0)
  otherDeductions Float    @default(0)
  totalDeductions Float
  netPay          Float
  // Employer counterparts (tracked for remittance)
  sssER           Float    @default(0)
  philHealthER    Float    @default(0)
  pagIbigER       Float    @default(0)
  status          String   @default("DRAFT") // DRAFT | RELEASED
  createdAt       DateTime @default(now())
  @@unique([employeeId, periodStart, periodEnd])
}

model LeaveRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType  String   // SIL | MATERNITY | PATERNITY | SOLO_PARENT | MAGNA_CARTA | VAWC | BEREAVEMENT | OTHER
  startDate  DateTime
  endDate    DateTime
  days       Int      @default(1)
  reason     String?
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  approverId String?
  createdAt  DateTime @default(now())
}
