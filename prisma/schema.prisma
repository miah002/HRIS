// HRIS Prisma schema. Local dev: SQLite file. Production: Turso (libSQL).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Auth ---
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("OWNER") // OWNER | HR | EMPLOYEE
  canPrepareOT  Boolean   @default(false)
  canCheckOT    Boolean   @default(false)
  canApproveOT  Boolean   @default(false)
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id])
  employeeId    String?   @unique
  employee      Employee? @relation(fields: [employeeId], references: [id])
  accounts      Account[]
  sessions      Session[]
  loginAttempts Int       @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// --- Core HR ---
model Company {
  id                String             @id @default(cuid())
  name              String
  tin               String?
  address           String?
  users             User[]
  employees         Employee[]
  loans             Loan[]
  complianceRecords ComplianceRecord[]
  otApprovals       OTApproval[]
  payrollPeriods    PayrollPeriod[]
  holidays          Holiday[]
  createdAt         DateTime           @default(now())
}

model Holiday {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      DateTime
  name      String
  type      String   // RH | SH (Regular Holiday | Special Non-Working)
  createdAt DateTime @default(now())
  @@unique([companyId, date])
}

model Employee {
  id               String         @id @default(cuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id])
  employeeNumber   String         @unique
  firstName        String
  middleName       String?
  lastName         String
  email            String?
  mobile           String?
  sex              String?   // MALE | FEMALE
  civilStatus      String?   // SINGLE | MARRIED | WIDOWED | SEPARATED
  birthDate        DateTime?
  dateHired        DateTime
  position         String
  department       String
  employmentStatus String         // REGULAR | PROBATIONARY | PROJECT | CASUAL | CONTRACTUAL
  basicMonthlyRate Float
  tin              String?
  sssNumber        String?
  philHealthNumber String?
  pagIbigNumber    String?
  archived         Boolean        @default(false)
  archivedAt       DateTime?
  notes            String?
  hdmfMp2Monthly   Float          @default(0)
  // Address
  addressStreet    String?
  addressCity      String?
  addressProvince  String?
  addressZip       String?
  // Separation
  separationDate   DateTime?
  separationType   String?        // RESIGNED | RETIRED | END_OF_CONTRACT | TERMINATED | REDUNDANCY | RETRENCHMENT | DEATH
  separationNotes  String?
  attendance       Attendance[]
  payrolls         Payroll[]
  leaves           LeaveRequest[]
  documents        Document[]
  loans            Loan[]
  user             User?
  emergencyContacts EmergencyContact[]
  history           EmployeeHistory[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model EmergencyContact {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String
  email        String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  @@unique([employeeId, isPrimary])
}

model EmployeeHistory {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          String   // HIRED | PROMOTION | POSITION_CHANGE | DEPARTMENT_TRANSFER | SALARY_CHANGE | STATUS_CHANGE | SEPARATION
  effectiveDate DateTime
  field         String?
  fromValue     String?
  toValue       String?
  notes         String?
  createdAt     DateTime @default(now())
}

model Document {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String
  url        String
  expiresAt  DateTime?
  uploadedAt DateTime  @default(now())
}

model Attendance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  timeIn      DateTime?
  timeOut     DateTime?
  hoursWorked Float     @default(0)
  otHours     Float     @default(0)
  ndHours     Float     @default(0)
  isRestDay   Boolean   @default(false)
  isHoliday   Boolean   @default(false)
  otRateCode  String?
  notes       String?
  @@unique([employeeId, date])
}

model Payroll {
  id                    String             @id @default(cuid())
  employeeId            String
  employee              Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart           DateTime
  periodEnd             DateTime
  // Attendance-based tracking
  daysWorked            Float              @default(0)
  regularHours          Float              @default(0)
  // Earnings
  basicPay              Float
  overtimePay           Float              @default(0)
  nightDiffPay          Float              @default(0)
  holidayPay            Float              @default(0)
  allowances            Float              @default(0)
  taxableAdjustments    Float              @default(0)
  nonTaxableAdjustments Float              @default(0)
  grossPay              Float
  // Deductions
  sssEE                 Float              @default(0)
  philHealthEE          Float              @default(0)
  pagIbigEE             Float              @default(0)
  withholdingTax        Float              @default(0)
  loanDeductions        Float              @default(0)
  otherDeductions       Float              @default(0)
  totalDeductions       Float
  netPay                Float
  sssER                 Float              @default(0)
  philHealthER          Float              @default(0)
  pagIbigER             Float              @default(0)
  lateMinutes           Float              @default(0)
  lateDeduction         Float              @default(0)
  undertimeMinutes      Float              @default(0)
  undertimeDeduction    Float              @default(0)
  hdmfMp2               Float              @default(0)
  // Payroll Register breakdown (stored at runPayroll time)
  absenceDeduction      Float              @default(0)
  sssLoanDeduction      Float              @default(0)
  hdmfLoanDeduction     Float              @default(0)
  cashAdvanceDeduction  Float              @default(0)
  status                String             @default("DRAFT") // DRAFT | RELEASED
  adjustments           PayrollAdjustment[]
  createdAt             DateTime           @default(now())
  @@unique([employeeId, periodStart, periodEnd])
}

model PayrollAdjustment {
  id          String   @id @default(cuid())
  payrollId   String
  payroll     Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  type        String   // TAXABLE | NON_TAXABLE
  description String
  amount      Float
  createdAt   DateTime @default(now())
}

model LeaveRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  days       Int      @default(1)
  reason     String?
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  isWithPay  Boolean  @default(true)       // false = without pay; set at approval time
  approverId String?
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime @default(now())
}

model Loan {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  type             String   // SSS_SALARY | PAGIBIG_MPL | CASH_ADVANCE | OTHER
  description      String?
  totalAmount      Float
  balance          Float
  monthlyDeduction Float
  startDate        DateTime
  status           String   @default("ACTIVE") // ACTIVE | PAID | CANCELLED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model OTApproval {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  status      String    @default("PENDING") // PENDING | PREPARED | CHECKED | APPROVED
  preparedBy  String?
  preparedAt  DateTime?
  checkedBy   String?
  checkedAt   DateTime?
  approvedBy  String?
  approvedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  @@unique([companyId, periodStart, periodEnd])
}

model PayrollPeriod {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  label       String
  status      String    @default("OPEN") // OPEN | CLOSED
  closedBy    String?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  @@unique([companyId, periodStart, periodEnd])
}

model ComplianceRecord {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  type      String    // BIR_1601C | BIR_2316 | BIR_1604C | SSS_R3 | PHIC_RF1 | HDMF_MCRF
  period    String    // "2026-04" monthly, "2026" annual
  dueDate   DateTime
  filedAt   DateTime?
  renewedAt DateTime?
  status    String    @default("PENDING") // PENDING | FILED | OVERDUE
  notes     String?
  createdAt DateTime  @default(now())
  @@unique([companyId, type, period])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  userId    String?
  action    String   // LOGIN | PAYROLL_RUN | PAYROLL_RELEASE | PAYROLL_RELEASE_ALL | EMPLOYEE_SEPARATE | DOCUMENT_ADD | DOCUMENT_DELETE | LEAVE_APPROVE | LEAVE_REJECT | LEAVE_REVOKE | ROLE_CHANGE | COMPANY_UPDATE
  target    String?
  targetId  String?
  meta      String?  // JSON string for extra context
  createdAt DateTime @default(now())
}
